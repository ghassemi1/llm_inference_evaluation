OPENAI_BASE_URL=http://XXXXXXXX/v1
OPENAI_API_KEY=XXXXXXX
OPENAI_MODEL=qwen2.5-3b

# Optional: vLLM Prometheus metrics (usually NOT under /v1)
VLLM_METRICS_URL=http://XXXXXXXX/metrics

# Optional: NVIDIA GPU metrics via DCGM exporter (Prometheus)
# If you run dcgm-exporter on the vLLM host (often port 9400), set:
#   http://YOUR_HOST:9400/metrics
# If you expose it via ngrok, use the ngrok /metrics URL.
DCGM_METRICS_URL=https://XXXXXXXXXXXX/metrics

# Benchmark generation params
TEMPERATURE=0.0
MAX_TOKENS=256

# Concurrency benchmark defaults
CONCURRENCY_LEVELS=1,2,4,8,16,32
DURATION_S=60
WARMUP_S=10
REQUEST_TIMEOUT_S=120
METRICS_TIMEOUT_S=10

# Prompt dataset (HuggingFace)
HF_TOKEN=hf_XXXXXXXXXXXXXXXXX
HF_DATASET=HuggingFaceH4/ultrachat_200k
HF_SPLIT=train_sft
DATA_DIR=data
NUM_PROMPTS=500
PROMPT_MAX_CHARS=600
SAMPLE_SEED=123
